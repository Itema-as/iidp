# Copy to terraform.tfvars (gitignored) and fill in. Secrets can also be passed
# as TF_VAR_hcloud_token. The state backend reads its own credentials from
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, which `source ../tofu-env.sh`
# loads from infra/state-bucket/terraform.tfvars; see backend.tf.

hcloud_token   = "..."
ssh_public_key = "ssh-ed25519 AAAA... admin@example"

# ArgoCD's and the Deploy gate's credential for the (private) Platform
# repository: the org GitHub App the bootstrap wizard's "GitHub App for the
# Deploy gate and ArgoCD" stage creates (id and installation id also recorded in the Platform
# repository's platform.yaml). No default -- every Platform has its own
# App -- and the private key is the App's downloaded PEM, so this file
# must stay out of git (it already is: infra/platform/.gitignore and the
# repository root's .gitignore both ignore *.tfvars, keeping only
# terraform.tfvars.example tracked).
platform_repo_github_app_id              = 123456
platform_repo_github_app_installation_id = 78901234
platform_repo_github_app_private_key     = <<EOT
-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----
EOT

# The node's credential for pulling Applications' private images from GHCR
# (ADR-0005): a classic personal access token with only the read:packages
# scope, and the GitHub login that owns it. The bootstrap wizard's "GHCR
# pull token" stage checks the token and writes both. cloud-init puts them
# in /etc/rancher/k3s/registries.yaml at first boot; on a running node,
# see infra/README.md, "Adding or rotating the GHCR pull token".
ghcr_pull_username = "platform-admin-login"
ghcr_pull_token    = "ghp_..."

# Everything else has an agreed default in variables.tf; set it here only to
# override, for example:
# server_type = "cpx32"
# k3s_version = "v1.36.5+k3s1"

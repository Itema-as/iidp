#cloud-config
# First boot of the Platform node. Provider-neutral: any host that accepts
# cloud-init user data can run this unchanged. Rendered by OpenTofu with
# templatefile(): a dollar sign followed by a brace is a template value, so
# shell expansions that need braces must be written with a doubled dollar.
#
# The bootstrap script is written to disk and then run once by cloud-init.
# It is safe to re-run by hand (ssh root@<node> iidp-bootstrap) after a
# failure: every step either converges or is skipped when already done.
# Version bumps are applied the same way, by re-running it with K3S_VERSION,
# ARGOCD_CHART_VERSION, HELM_VERSION and HELM_SHA256_LINUX_AMD64 set in the
# environment; the values rendered below are the defaults for the first
# boot. Rotating the Platform repository's GitHub App credential (below)
# works the same way, with PLATFORM_REPO_GITHUB_APP_PRIVATE_KEY_B64 (and,
# if they changed too, PLATFORM_REPO_GITHUB_APP_ID and
# PLATFORM_REPO_GITHUB_APP_INSTALLATION_ID) set in the environment.
#
# k3s's registries.yaml (the GHCR pull credential) is not part of that
# script: it is a plain file below, which cloud-init writes before runcmd
# starts the script, so it exists before k3s first starts. Adding or
# rotating it on a running node means writing the file over ssh and
# restarting k3s (infra/README.md, "Adding or rotating the GHCR pull
# token").

write_files:
  # Credentials for pulling Applications' private images from ghcr.io
  # (ADR-0005), rendered by OpenTofu (local.registries_yaml in
  # bootstrap.tf) and carried as base64. k3s reads this file only when it
  # starts. Not deferred: write_files runs in cloud-init's init stage,
  # before runcmd installs k3s.
  - path: /etc/rancher/k3s/registries.yaml
    permissions: "0600"
    owner: root:root
    encoding: b64
    content: ${registries_yaml_b64}
  - path: /usr/local/sbin/iidp-bootstrap
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      # Installs k3s and ArgoCD, creates the age key once, writes ArgoCD's
      # credential for the Platform repository, and applies the root
      # ArgoCD Application. Everything after that is reconciled by ArgoCD
      # from the Platform repository.
      set -euo pipefail
      exec > >(tee -a /var/log/iidp-bootstrap.log) 2>&1

      # Overridable from the environment for in-place upgrades:
      #   K3S_VERSION=vX.Y.Z+k3sN ARGOCD_CHART_VERSION=X.Y.Z \
      #   HELM_VERSION=vX.Y.Z HELM_SHA256_LINUX_AMD64=... iidp-bootstrap
      K3S_VERSION="$${K3S_VERSION:-${k3s_version}}"
      # The argo-cd Helm chart version: ArgoCD is installed by rendering
      # this chart, not the upstream install.yaml (see the "installing
      # ArgoCD" step below).
      ARGOCD_CHART_VERSION="$${ARGOCD_CHART_VERSION:-${argocd_chart_version}}"
      HELM_VERSION="$${HELM_VERSION:-${helm_version}}"
      HELM_SHA256_LINUX_AMD64="$${HELM_SHA256_LINUX_AMD64:-${helm_sha256_linux_amd64}}"
      PLATFORM_REPO_URL="${platform_repo_url}"
      PLATFORM_REPO_PATH="${platform_repo_bootstrap_path}"
      # The org GitHub App that authenticates ArgoCD to the (private)
      # Platform repository. The private key travels as base64 (see the
      # header comment above) and is decoded only where it is used, below.
      PLATFORM_REPO_GITHUB_APP_ID="$${PLATFORM_REPO_GITHUB_APP_ID:-${platform_repo_github_app_id}}"
      PLATFORM_REPO_GITHUB_APP_INSTALLATION_ID="$${PLATFORM_REPO_GITHUB_APP_INSTALLATION_ID:-${platform_repo_github_app_installation_id}}"
      PLATFORM_REPO_GITHUB_APP_PRIVATE_KEY_B64="$${PLATFORM_REPO_GITHUB_APP_PRIVATE_KEY_B64:-${platform_repo_github_app_private_key_b64}}"

      export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
      export DEBIAN_FRONTEND=noninteractive

      log() { printf '[iidp-bootstrap] %s\n' "$*"; }

      # At first boot apt-daily may still hold the dpkg lock; wait for it
      # instead of failing.
      log "installing packages"
      apt-get -o DPkg::Lock::Timeout=300 -q update
      apt-get -o DPkg::Lock::Timeout=300 -q -y install age curl

      # Traefik and ServiceLB stay enabled: ServiceLB is what binds Traefik's
      # LoadBalancer Service to the node's public IP (no Hetzner load balancer,
      # ADR-0001). The installer restarts k3s every time it runs, so skip it
      # when the requested version is already installed; with a different
      # version it upgrades the existing installation in place.
      installed_k3s=$(k3s --version 2>/dev/null | awk 'NR == 1 { print $3 }' || true)
      if [ "$installed_k3s" = "$K3S_VERSION" ]; then
        log "k3s $K3S_VERSION already installed"
      else
        log "installing k3s $K3S_VERSION"
        curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="$K3S_VERSION" sh -s - server
      fi

      log "waiting for the node to become Ready"
      deadline=$(( $(date +%s) + 600 ))
      until kubectl wait --for=condition=Ready node --all --timeout=60s >/dev/null 2>&1; do
        if [ "$(date +%s)" -ge "$deadline" ]; then
          log "node not Ready after 10 minutes; see journalctl -u k3s"
          exit 1
        fi
        sleep 5
      done

      # helm renders the argo-cd chart below; it is not on the base image.
      # Re-run is idempotent: skipped when the pinned version is already
      # installed, otherwise the binary is replaced in place.
      installed_helm=$(helm version --template '{{.Version}}' 2>/dev/null || true)
      if [ "$installed_helm" = "$HELM_VERSION" ]; then
        log "helm $HELM_VERSION already installed"
      else
        log "installing helm $HELM_VERSION"
        helm_tmp=$(mktemp -d)
        curl -sfL -o "$helm_tmp/helm.tar.gz" \
          "https://get.helm.sh/helm-$HELM_VERSION-linux-amd64.tar.gz"
        echo "$HELM_SHA256_LINUX_AMD64  $helm_tmp/helm.tar.gz" | sha256sum -c -
        tar -xzf "$helm_tmp/helm.tar.gz" -C "$helm_tmp"
        install -m 0755 "$helm_tmp/linux-amd64/helm" /usr/local/bin/helm
        rm -rf "$helm_tmp"
      fi

      log "installing ArgoCD (argo-cd chart $ARGOCD_CHART_VERSION)"
      kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -
      # Rendered from the argo-cd chart itself, not the upstream
      # install.yaml: the objects this creates already have the selectors
      # the argocd bootstrap Application's chart takeover expects (chart
      # and cloud-init use the same fullnameOverride and crds.install), so
      # the first sync only ever patches instead of having to delete and
      # recreate Deployments and the application controller's StatefulSet
      # (docs/implementation-notes/04-bootstrap.md, "Installing from the
      # chart, not the upstream manifests"). Server-side apply is required:
      # the ArgoCD CRDs exceed the annotation size limit of client-side
      # apply.
      helm template argocd argo-cd --repo https://argoproj.github.io/argo-helm \
        --version "$ARGOCD_CHART_VERSION" --namespace argocd --include-crds \
        --set fullnameOverride=argocd --set crds.install=true \
        | kubectl apply -n argocd --server-side --force-conflicts -f -
      kubectl wait --for=condition=established crd/applications.argoproj.io --timeout=120s

      # The age private key exists only in this Secret, in the layout KSOPS
      # mounts into argocd-repo-server (key keys.txt). Generated once; a
      # re-run keeps the existing key.
      if ! kubectl -n argocd get secret sops-age >/dev/null 2>&1; then
        log "generating the age key pair"
        keydir=$(mktemp -d)
        chmod 700 "$keydir"
        age-keygen -o "$keydir/keys.txt"
        kubectl -n argocd create secret generic sops-age --from-file=keys.txt="$keydir/keys.txt"
        rm -rf "$keydir"
      fi

      # Derive the public key from the Secret so /root/age.pub always matches
      # the key the cluster holds, including after a restored key.
      kubectl -n argocd get secret sops-age -o jsonpath='{.data.keys\.txt}' \
        | base64 -d | age-keygen -y > /root/age.pub
      chmod 644 /root/age.pub
      log "age public key: $(cat /root/age.pub)"

      # ArgoCD's credential for the Platform repository, so the root
      # Application below can reconcile it from first boot with nobody
      # touching the cluster (issue #41). Same App the Deploy gate commits
      # deploys as (contents: write, which already implies the read ArgoCD
      # needs), and the gate mounts this very Secret, so keep its name and
      # keys (docs/implementation-notes/60-deploy-gate.md); the declarative shape is the one the ArgoCD
      # documentation gives for GitHub App repository credentials: a Secret
      # labelled argocd.argoproj.io/secret-type: repository. Re-running
      # this script re-applies it, so a rotated key or a changed
      # installation id (both overridable from the environment, see the
      # header comment above) take effect on the next run. The decoded key
      # exists only in this shell's memory -- never written to disk, never
      # passed to log() or echo -- even though this whole script's stdout
      # and stderr are teed to /var/log/iidp-bootstrap.log.
      log "writing ArgoCD's Platform-repository credential"
      GITHUB_APP_PRIVATE_KEY=$(printf '%s' "$PLATFORM_REPO_GITHUB_APP_PRIVATE_KEY_B64" | base64 -d)
      kubectl apply -n argocd -f - <<EOF
      apiVersion: v1
      kind: Secret
      metadata:
        name: platform-repo-github-app
        namespace: argocd
        labels:
          argocd.argoproj.io/secret-type: repository
      stringData:
        type: git
        url: $PLATFORM_REPO_URL
        githubAppID: "$PLATFORM_REPO_GITHUB_APP_ID"
        githubAppInstallationID: "$PLATFORM_REPO_GITHUB_APP_INSTALLATION_ID"
        githubAppPrivateKey: |
      $(printf '%s\n' "$GITHUB_APP_PRIVATE_KEY" | sed 's/^/    /')
      EOF
      unset GITHUB_APP_PRIVATE_KEY

      log "applying the root ArgoCD Application"
      kubectl apply -f - <<EOF
      apiVersion: argoproj.io/v1alpha1
      kind: Application
      metadata:
        name: platform
        namespace: argocd
      spec:
        project: default
        source:
          repoURL: $PLATFORM_REPO_URL
          targetRevision: HEAD
          path: $PLATFORM_REPO_PATH
        destination:
          server: https://kubernetes.default.svc
          namespace: argocd
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
          syncOptions:
            - CreateNamespace=true
            - ServerSideApply=true
      EOF

      log "bootstrap complete"

runcmd:
  - [/usr/local/sbin/iidp-bootstrap]
